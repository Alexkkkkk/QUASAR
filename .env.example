# QUASAR Environment Configuration
#
# WARNING: Never put real secrets in this file or in any committed file.
# Copy this file to `.env` (git-ignored) and fill in real values locally.

# TON deployment wallet mnemonic: 24 words, space-separated.
# Keep it ONLY in your local .env or a secret manager - never in git.
WALLET_MNEMONIC=

# Network: mainnet | testnet
TON_NETWORK=testnet

# TON Center API key (get one at https://t.me/tonapibot)
TONCENTER_API_KEY=

# TEP-64 jetton metadata URL baked into the QuasarMaster content cell (F-01).
# Validated by a deploy-time preflight check; CANNOT be changed after the
# jetton is deployed - point it at reliable hosting with anonymous access.
# Default: raw.githubusercontent.com (git-versioned). For production consider
# GitHub Pages or your own domain serving proper application/json MIME type.
JETTON_METADATA_URL=https://raw.githubusercontent.com/Alexkkkkk/QUASAR/main/website/metadata.json
