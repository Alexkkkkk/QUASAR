# QUASAR Environment Configuration
#
# WARNING: Never put real secrets in this file or in any committed file.
# Copy this file to `.env` (git-ignored) and fill in real values locally.

# TON deployment wallet mnemonic: 24 words, space-separated.
# Keep it ONLY in your local .env or a secret manager - never in git.
WALLET_MNEMONIC=

# Network: mainnet | testnet
TON_NETWORK=testnet

# TON Center API key (get one at https://t.me/tonapibot)
TONCENTER_API_KEY=

# Optional override for the TON Center JSON-RPC endpoint used by
# scripts/testnet_smoke.ts. Leave empty to derive it from TON_NETWORK
# (https://toncenter.com / https://testnet.toncenter.com).
TONCENTER_ENDPOINT=

# TEP-64 jetton metadata URL baked into the QuasarMaster content cell (F-01).
# Validated by a deploy-time preflight check; CANNOT be changed after the
# jetton is deployed - point it at reliable hosting with anonymous access.
# MUST be served with Content-Type: application/json. raw.githubusercontent.com
# serves everything as text/plain, so it is NOT a valid TEP-64 off-chain host
# (issue #77). Default: GitHub Pages, which serves website/metadata.json as JSON.
JETTON_METADATA_URL=https://alexkkkkk.github.io/QUASAR/metadata.json

# TEP-64 content layout baked into the init data by scripts/deploy_all.ts.
#   offchain  (default)  0x01 ++ URI          - attributes live in the JSON document
#   onchain              0x00 ++ dictionary   - attributes live on-chain
#   semichain            0x00 ++ dictionary   - on-chain dictionary plus a `uri` key
# The cell is part of the init data; a mistake is only correctable through the
# 48h ProposeContent -> "Apply Content" timelock, so the deploy preflights it.
JETTON_CONTENT_LAYOUT=offchain

# Admin timelock (M-02): external multisig that controls Master/DeFi.
# Defaults to the deployer wallet if unset; min delay must be >= 86400s.
TIMELOCK_ADMIN=
TIMELOCK_MIN_DELAY=86400

# Optional: hand the AI oracle role to a separate key at deploy time. When it is
# unset the master keeps aiEnabled = false and the deployer stays the oracle.
# Read by scripts/deploy_all.ts; the value must be a valid TON address.
AI_ORACLE_ADDRESS=

# Post-Pages live smoke (npm run tonconnect:smoke, scripts/check_tonconnect.ts).
# TON_CONNECT_ORIGIN must match the `url` field of website/tonconnect-manifest.json
# and the origin that actually serves it; TON_CONNECT_MANIFEST_URL overrides the
# derived "<origin>/tonconnect-manifest.json" when the manifest is hosted elsewhere.
TON_CONNECT_ORIGIN=https://alexkkkkk.github.io/QUASAR
TON_CONNECT_MANIFEST_URL=

# Deployment-artifact validator (npm run deployment:check). Points at the JSON
# written by scripts/deploy_all.ts. A missing file is reported as "no deployment
# is published" and the check still exits 0, so it is safe to run in CI.
DEPLOYMENT_FILE=website/deployment.json

# xAI (Grok) API key for the off-chain risk oracle (scripts/ai_oracle.ts).
# Read from the environment only - never commit a real key.
# Accepted names, in priority order: XAI_API_KEY, GROK_API_KEY.
XAI_API_KEY=

# Optional: override the oracle model (default: grok-4.7, see docs.x.ai/docs/models).
GROK_MODEL=

# AI oracle signing key (A-67). The key NEVER goes on-chain: the contract stores
# only the public key, and every decision is authenticated by an Ed25519
# signature, so the relaying wallet is untrusted and can be a hot address.
# 32-byte seed or 64-byte secret key, hex. Generate with: npm run oracle:keygen
ORACLE_SIGNING_KEY=
# Which form ORACLE_SIGNING_KEY uses: seed | secret
ORACLE_SIGNING_KEY_KIND=seed

# ---------------------------------------------------------------------------
# CI / automation (read by scripts/hub_audit.ts)
# ---------------------------------------------------------------------------
# GitHub Actions injects these automatically; do not store real tokens here.
# Leave them unset locally to skip the live settings checks.
#
# GITHUB_TOKEN          Ephemeral Actions token (injected by GitHub Actions).
# GH_TOKEN              Alias accepted when running the audit locally.
# GITHUB_REPOSITORY     "owner/repo" slug; defaults to Alexkkkkk/QUASAR.
