((int, int, slice, cell, cell, int, int, slice, int, int, int, int, int, int, int, int, int, int, int, int, int, int, int, slice, int, int, int, int, cell, cell, int, int, int, int, int, int, int, int, int, cell, int, cell, cell, int, int, int, int, int, cell, int, int, int, int, cell, int, int, int, cell, int, int, int, int, int, int, int, cell, int, cell), int) $QuasarMaster$_contract_router_internal((int, int, slice, cell, cell, int, int, slice, int, int, int, int, int, int, int, int, int, int, int, int, int, int, int, slice, int, int, int, int, cell, cell, int, int, int, int, int, int, int, int, int, cell, int, cell, cell, int, int, int, int, int, cell, int, int, int, int, cell, int, int, int, cell, int, int, int, int, int, int, int, cell, int, cell) self, int msg_bounced, slice in_msg) impure inline_ref {
    ;; Handle bounced messages
    if (msg_bounced) {
        return (self, true);
