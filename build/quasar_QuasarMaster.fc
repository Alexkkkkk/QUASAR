        ($self'totalSupply, $self'mintable, $self'owner, $self'content, $self'walletCode, $self'feeBps, $self'feeBurnShare, $self'treasury, $self'totalBurned, $self'totalFeesCollected, $self'maxTxBps, $self'maxWalletBps, $self'cooldownSeconds, $self'tradingEnabled, $self'buybackEnabled, $self'buybackPool, $self'buybackThreshold, $self'buybackCooldown, $self'buybackBurnPercent, $self'lastBuybackTime, $self'totalBuybacks, $self'totalQsrBurnedViaBuyback, $self'totalTonSpentOnBuyback, $self'aiOracle, $self'aiEnabled, $self'aiFullAutonomy, $self'lastRebalanceTime, $self'signalCount, $self'priceHistory, $self'anomalyLog, $self'anomalyIndex, $self'minConfidence, $self'emergencyPause, $self'aiActionCooldown, $self'lastAiActionTime, $self'heartbeatTimeout, $self'lastHeartbeat, $self'ownerOverrideWindow, $self'vetoThresholdBps, $self'aiActionLog, $self'aiActionIndex, $self'pendingAiActions, $self'vetoLog, $self'totalVetoStake, $self'stakingEnabled, $self'stakingApyBps, $self'stakingMinStake, $self'stakingLockPeriod, $self'stakers, $self'totalStaked, $self'stakingRewardsPool, $self'referralEnabled, $self'referralRewardBps, $self'referrals, $self'vestingEnabled, $self'teamAllocation, $self'teamClaimed, $self'vestingSchedules, $self'lotteryEnabled, $self'lotteryTicketPrice, $self'lotteryDrawInterval, $self'lotteryJackpotShare, $self'lotteryRound, $self'lotteryLastDraw, $self'lotteryJackpot, $self'lotteryTickets, $self'lotteryTicketCount, $self'lotteryWinners, $self'defiAddress, $self'defiFeeShareBps)~$QuasarMaster$_fun__requireOwner();
        $self'emergencyPause = false;
        $self'tradingEnabled = true;
        $QuasarMaster$_contract_store(($self'totalSupply, $self'mintable, $self'owner, $self'content, $self'walletCode, $self'feeBps, $self'feeBurnShare, $self'treasury, $self'totalBurned, $self'totalFeesCollected, $self'maxTxBps, $self'maxWalletBps, $self'cooldownSeconds, $self'tradingEnabled, $self'buybackEnabled, $self'buybackPool, $self'buybackThreshold, $self'buybackCooldown, $self'buybackBurnPercent, $self'lastBuybackTime, $self'totalBuybacks, $self'totalQsrBurnedViaBuyback, $self'totalTonSpentOnBuyback, $self'aiOracle, $self'aiEnabled, $self'aiFullAutonomy, $self'lastRebalanceTime, $self'signalCount, $self'priceHistory, $self'anomalyLog, $self'anomalyIndex, $self'minConfidence, $self'emergencyPause, $self'aiActionCooldown, $self'lastAiActionTime, $self'heartbeatTimeout, $self'lastHeartbeat, $self'ownerOverrideWindow, $self'vetoThresholdBps, $self'aiActionLog, $self'aiActionIndex, $self'pendingAiActions, $self'vetoLog, $self'totalVetoStake, $self'stakingEnabled, $self'stakingApyBps, $self'stakingMinStake, $self'stakingLockPeriod, $self'stakers, $self'totalStaked, $self'stakingRewardsPool, $self'referralEnabled, $self'referralRewardBps, $self'referrals, $self'vestingEnabled, $self'teamAllocation, $self'teamClaimed, $self'vestingSchedules, $self'lotteryEnabled, $self'lotteryTicketPrice, $self'lotteryDrawInterval, $self'lotteryJackpotShare, $self'lotteryRound, $self'lotteryLastDraw, $self'lotteryJackpot, $self'lotteryTickets, $self'lotteryTicketCount, $self'lotteryWinners, $self'defiAddress, $self'defiFeeShareBps));
        return ();
    }
    ;; Receive "Toggle AI" message
    if (text_op == 0x228aefdc558b3d1b9bb87fc33d71a2e40504be5a8d6acc8d737ee0215d75d86c) {
        ($self'totalSupply, $self'mintable, $self'owner, $self'content, $self'walletCode, $self'feeBps, $self'feeBurnShare, $self'treasury, $self'totalBurned, $self'totalFeesCollected, $self'maxTxBps, $self'maxWalletBps, $self'cooldownSeconds, $self'tradingEnabled, $self'buybackEnabled, $self'buybackPool, $self'buybackThreshold, $self'buybackCooldown, $self'buybackBurnPercent, $self'lastBuybackTime, $self'totalBuybacks, $self'totalQsrBurnedViaBuyback, $self'totalTonSpentOnBuyback, $self'aiOracle, $self'aiEnabled, $self'aiFullAutonomy, $self'lastRebalanceTime, $self'signalCount, $self'priceHistory, $self'anomalyLog, $self'anomalyIndex, $self'minConfidence, $self'emergencyPause, $self'aiActionCooldown, $self'lastAiActionTime, $self'heartbeatTimeout, $self'lastHeartbeat, $self'ownerOverrideWindow, $self'vetoThresholdBps, $self'aiActionLog, $self'aiActionIndex, $self'pendingAiActions, $self'vetoLog, $self'totalVetoStake, $self'stakingEnabled, $self'stakingApyBps, $self'stakingMinStake, $self'stakingLockPeriod, $self'stakers, $self'totalStaked, $self'stakingRewardsPool, $self'referralEnabled, $self'referralRewardBps, $self'referrals, $self'vestingEnabled, $self'teamAllocation, $self'teamClaimed, $self'vestingSchedules, $self'lotteryEnabled, $self'lotteryTicketPrice, $self'lotteryDrawInterval, $self'lotteryJackpotShare, $self'lotteryRound, $self'lotteryLastDraw, $self'lotteryJackpot, $self'lotteryTickets, $self'lotteryTicketCount, $self'lotteryWinners, $self'defiAddress, $self'defiFeeShareBps)~$QuasarMaster$_fun__requireOwner();
        throw_unless(44695, (~ $self'aiFullAutonomy));
        $self'aiEnabled = (~ $self'aiEnabled);
        $QuasarMaster$_contract_store(($self'totalSupply, $self'mintable, $self'owner, $self'content, $self'walletCode, $self'feeBps, $self'feeBurnShare, $self'treasury, $self'totalBurned, $self'totalFeesCollected, $self'maxTxBps, $self'maxWalletBps, $self'cooldownSeconds, $self'tradingEnabled, $self'buybackEnabled, $self'buybackPool, $self'buybackThreshold, $self'buybackCooldown, $self'buybackBurnPercent, $self'lastBuybackTime, $self'totalBuybacks, $self'totalQsrBurnedViaBuyback, $self'totalTonSpentOnBuyback, $self'aiOracle, $self'aiEnabled, $self'aiFullAutonomy, $self'lastRebalanceTime, $self'signalCount, $self'priceHistory, $self'anomalyLog, $self'anomalyIndex, $self'minConfidence, $self'emergencyPause, $self'aiActionCooldown, $self'lastAiActionTime, $self'heartbeatTimeout, $self'lastHeartbeat, $self'ownerOverrideWindow, $self'vetoThresholdBps, $self'aiActionLog, $self'aiActionIndex, $self'pendingAiActions, $self'vetoLog, $self'totalVetoStake, $self'stakingEnabled, $self'stakingApyBps, $self'stakingMinStake, $self'stakingLockPeriod, $self'stakers, $self'totalStaked, $self'stakingRewardsPool, $self'referralEnabled, $self'referralRewardBps, $self'referrals, $self'vestingEnabled, $self'teamAllocation, $self'teamClaimed, $self'vestingSchedules, $self'lotteryEnabled, $self'lotteryTicketPrice, $self'lotteryDrawInterval, $self'lotteryJackpotShare, $self'lotteryRound, $self'lotteryLastDraw, $self'lotteryJackpot, $self'lotteryTickets, $self'lotteryTicketCount, $self'lotteryWinners, $self'defiAddress, $self'defiFeeShareBps));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}


() __tact_selector_hack_asm() impure asm """
@atend @ 1 {
        execute current@ context@ current!
        {
            // The core idea of this function is to save gas by avoiding unnecessary dict jump, when recv_internal/recv_external is called
            // We want to extract recv_internal/recv_external from the dict and select needed function
            // not by jumping to the needed function by it's index, but by using usual IF statements.

            }END> b> // Close previous builder, now we have a cell of previous code on top of the stack

            <{ // Start of the new code builder
                SETCP0
                // Swap the new code builder with the previous code, now we have previous code on top of the stack
                swap
                // Transform cell to slice and load first ref from the previous code, now we have the dict on top of the stack
                <s ref@

                // Extract the recv_internal from the dict
                dup 0 swap @procdictkeylen idict@ { "internal shortcut error" abort } ifnot
                swap

                // Delete the recv_internal from the dict
                0 swap @procdictkeylen idict- drop
                // Delete the recv_external from the dict (it's okay if it's not there)
                -1 swap @procdictkeylen idict- drop
                // Delete the __tact_selector_hack from the dict
                65535 swap @procdictkeylen idict- drop

                // Bring the code builder from the bottom of the stack
                // because if recv_external extraction is optional, and the number of elements on the stack is not fixed
                depth 1- roll
                // Swap with the dict from which we extracted recv_internal and (maybe) recv_external
                swap

                // Check if the dict is empty
                dup null?
                // Store a copy of this flag in the bottom of the stack
                dup depth 1- -roll
                {
                    // If the dict is empty, just drop it (it will be null if it's empty)
                    drop
                }
                {
                    // If the dict is not empty, prepare continuation to be stored in c3
                    <{
                        // Save this dict as first ref in this continuation, it will be pushed in runtime by DICTPUSHCONST
                        swap @procdictkeylen DICTPUSHCONST
                        // Jump to the needed function by it's index
                        DICTIGETJMPZ
                        // If such key is not found, throw 11 along with the key as an argument
                        11 THROWARG
                    }> PUSHCONT
                    // Store the continuation in c3
                    c3 POP
                } cond

                // Function id is on top of the (runtime) stack
                DUP IFNOTJMP:<{
                    // place recv_internal here
                    DROP swap @addop
                }>

                // Bring back the flag, indicating if the dict is empty or not from the bottom of the stack
                depth 1- roll
                {
                    // If the dict is empty, throw 11
                    11 THROWARG
                }
                {
                    // If the dict is not empty, jump to continuation from c3
                    c3 PUSH JMPX
                } cond
            }> b>
        } : }END>c
        current@ context! current!
    } does @atend !
""";

() __tact_selector_hack() method_id(65535) {
    return __tact_selector_hack_asm();
}