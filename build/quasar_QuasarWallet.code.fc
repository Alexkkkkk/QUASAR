#pragma version =0.4.4;
#pragma allow-post-modification;
#pragma compute-asm-ltr;

#include "quasar_QuasarWallet.headers.fc";
#include "quasar_QuasarWallet.stdlib.fc";
#include "quasar_QuasarWallet.storage.fc";

;;
;; Contract QuasarWallet functions
;;

(int, slice, slice, int) $QuasarWallet$_contract_init(slice $owner, slice $master) impure inline_ref {
    var (($self'balance, $self'owner, $self'master, $self'lastTxTime)) = (null(), null(), null(), null());
    $self'balance = 0;
    $self'owner = $owner;
    $self'master = $master;
    $self'lastTxTime = 0;
    return ($self'balance, $self'owner, $self'master, $self'lastTxTime);
}

((int, slice, slice, int), (int, slice, slice, cell)) $QuasarWallet$_fun_get_wallet_data((int, slice, slice, int) $self) impure inline_ref {
    var (($self'balance, $self'owner, $self'master, $self'lastTxTime)) = $self;
    var $fresh$ret_53 = $JettonWalletData$_constructor_balance_owner_master_walletCode($self'balance, $self'owner, $self'master, $StateInit$_get_code($QuasarWallet$_init_child(__tact_context_sys, $self'owner, $self'master)));
    return (($self'balance, $self'owner, $self'master, $self'lastTxTime), $fresh$ret_53);
}

;;
;; Receivers of a Contract QuasarWallet
;;

(((int, slice, slice, int)), ()) $QuasarWallet$_internal_binary_TokenNotification((int, slice, slice, int) $self, (int, int, slice, slice) $msg) impure inline {
    var ($self'balance, $self'owner, $self'master, $self'lastTxTime) = $self;
    var ($msg'queryId, $msg'amount, $msg'from, $msg'forwardPayload) = $msg;
    throw_unless(49729, ( __tact_slice_eq_bits($self'master, __tact_context_get_sender()) ));
    $self'balance = ($self'balance + $msg'amount);
    return (($self'balance, $self'owner, $self'master, $self'lastTxTime), ());
}

(((int, slice, slice, int)), ()) $QuasarWallet$_internal_binary_TokenTransfer((int, slice, slice, int) $self, (int, int, slice, slice, cell, int, slice) $msg) impure inline {
    var ($self'balance, $self'owner, $self'master, $self'lastTxTime) = $self;
    var ($msg'queryId, $msg'amount, $msg'destination, $msg'responseDestination, $msg'customPayload, $msg'forwardTonAmount, $msg'forwardPayload) = $msg;
    throw_unless(14534, ( __tact_slice_eq_bits($self'owner, __tact_context_get_sender()) ));
    throw_unless(8660, ($self'balance >= $msg'amount));
    throw_unless(55849, (($global_now() - $self'lastTxTime) >= 5));
    $self'lastTxTime = $global_now();
    int $fee = (($msg'amount * 30) / 10000);
    if (($fee < 1)) {
        $fee = 1;
    }
    int $sendAmount = ($msg'amount - $fee);
    $self'balance = ($self'balance - $msg'amount);
    var ($init'code, $init'data) = $QuasarWallet$_init_child(__tact_context_sys, $msg'destination, $self'master);
    $global_send($SendParameters$_constructor_to_value_bounce_mode_body_code_data($global_contractAddress(($init'code, $init'data)), 0, true, 64, $TokenNotification$_store_cell($TokenNotification$_constructor_queryId_amount_from_forwardPayload($msg'queryId, $sendAmount, $self'owner, $msg'forwardPayload)), $init'code, $init'data));
    if (($fee > 0)) {
        $global_send($SendParameters$_constructor_to_value_bounce_mode_body($self'master, 0, false, 64, $FeeTransfer$_store_cell($FeeTransfer$_constructor_queryId_amount_originalSender_originalReceiver($msg'queryId, $fee, $self'owner, $msg'destination))));
    }
    return (($self'balance, $self'owner, $self'master, $self'lastTxTime), ());
}

(((int, slice, slice, int)), ()) $QuasarWallet$_internal_binary_TokenBurn((int, slice, slice, int) $self, (int, int, slice, cell) $msg) impure inline {
    var ($self'balance, $self'owner, $self'master, $self'lastTxTime) = $self;
    var ($msg'queryId, $msg'amount, $msg'responseDestination, $msg'customPayload) = $msg;
    throw_unless(14534, ( __tact_slice_eq_bits($self'owner, __tact_context_get_sender()) ));
    throw_unless(8660, ($self'balance >= $msg'amount));
    $self'balance = ($self'balance - $msg'amount);
    $global_send($SendParameters$_constructor_to_value_bounce_mode_body($self'master, 0, true, 64, $BurnNotification$_store_cell($BurnNotification$_constructor_queryId_amount_sender_responseDestination($msg'queryId, $msg'amount, $self'owner, $msg'responseDestination))));
    return (($self'balance, $self'owner, $self'master, $self'lastTxTime), ());
}

;;
;; Get methods of a Contract QuasarWallet
;;

_ %get_wallet_data() method_id(97026) {
    var self = $QuasarWallet$_contract_load();
    var res = self~$QuasarWallet$_fun_get_wallet_data();
    return $JettonWalletData$_to_external(res);
}

_ lazy_deployment_completed() method_id {
    return get_data().begin_parse().load_int(1);
}

;;
;; Routing of a Contract QuasarWallet
;;

((int, slice, slice, int), int) $QuasarWallet$_contract_router_internal((int, slice, slice, int) self, int msg_bounced, slice in_msg) impure inline_ref {
    ;; Handle bounced messages
    if (msg_bounced) {
        return (self, true);
    }
    
    ;; Parse incoming message
    int op = 0;
    if (slice_bits(in_msg) >= 32) {
        op = in_msg.preload_uint(32);
    }
    
    
    ;; Receive TokenNotification message
    if (op == 78460803) {
        var msg = in_msg~$TokenNotification$_load();
        self~$QuasarWallet$_internal_binary_TokenNotification(msg);
        return (self, true);
    }
    
    ;; Receive TokenTransfer message
    if (op == 2477503806) {
        var msg = in_msg~$TokenTransfer$_load();
        self~$QuasarWallet$_internal_binary_TokenTransfer(msg);
        return (self, true);
    }
    
    ;; Receive TokenBurn message
    if (op == 3884065811) {
        var msg = in_msg~$TokenBurn$_load();
        self~$QuasarWallet$_internal_binary_TokenBurn(msg);
        return (self, true);
    }
    
    return (self, false);
}

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    var msg_flags = cs~load_uint(4);
    var msg_bounced = -(msg_flags & 1);
    slice msg_sender_addr = __tact_verify_address(cs~load_msg_addr());
    __tact_context = (msg_bounced, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var self = $QuasarWallet$_contract_load();
    
    ;; Handle operation
    int handled = self~$QuasarWallet$_contract_router_internal(msg_bounced, in_msg);
    
    ;; Throw if not handled
    throw_unless(130, handled);
    
    ;; Persist state
    $QuasarWallet$_contract_store(self);
}
