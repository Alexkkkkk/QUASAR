;;
;; Routing of a Contract QuasarWallet
;;

;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'balance, $self'owner, $self'master, $self'lastTxTime) = $QuasarWallet$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) {
        ;; Skip 0xFFFFFFFF prefix of a bounced message
        in_msg~skip_bits(32);
        int op = 0;
        if (slice_bits(in_msg) >= 32) {
            op = in_msg~load_uint(32);
        }
        ;; Bounced handler for InternalTransfer message
        if (op == 0x178d4519) {
            var ($msg'queryId, $msg'amount) = in_msg~$InternalTransfer$_load_bounced();
            throw_unless(17062, ($msg'amount > 0));
            $self'balance = ($self'balance + $msg'amount);
            $QuasarWallet$_contract_store(($self'balance, $self'owner, $self'master, $self'lastTxTime));
            return ();
        }
        
        ;; Bounced handler for BurnNotification message
        if (op == 0x7bdd97de) {
            var ($msg'queryId, $msg'amount) = in_msg~$BurnNotification$_load_bounced();
            throw_unless(17062, ($msg'amount > 0));
            $self'balance = ($self'balance + $msg'amount);
            $QuasarWallet$_contract_store(($self'balance, $self'owner, $self'master, $self'lastTxTime));
            return ();
        }
        
        return ();
    }
    var op = in_msg~load_opcode_internal();
    ;; Receive InternalTransfer message
    if (op == 0x178d4519) {
        var $msg'queryId = in_msg~load_uint(64);
        var $msg'amount = in_msg~load_varuint16();
        var $msg'from = in_msg~load_msg_addr();
        var $msg'responseDestination = in_msg~load_msg_addr();
        var $msg'forwardTonAmount = in_msg~load_varuint16();
        var $msg'forwardPayload = in_msg;
        var ($sourceInit'code, $sourceInit'data) = $QuasarWallet$_init_child($msg'from, $self'master);
        throw_unless(49729, ( (( equal_slices_bits(__tact_context_get_sender(), $self'master) )) ? (true) : (( equal_slices_bits(__tact_context_get_sender(), $global_contractAddress(($sourceInit'code, $sourceInit'data))) )) ));
        throw_unless(17062, ($msg'amount > 0));
        $self'balance = ($self'balance + $msg'amount);
        if (($msg'forwardTonAmount > 0)) {
            $global_send($SendParameters$_constructor_to_value_bounce_mode_body($self'owner, $msg'forwardTonAmount, true, 3, $TokenNotification$_store_cell($TokenNotification$_constructor_queryId_amount_from_forwardPayload($msg'queryId, $msg'amount, $msg'from, $msg'forwardPayload), begin_cell())));
        }
        $QuasarWallet$_contract_store(($self'balance, $self'owner, $self'master, $self'lastTxTime));
        return ();
    }
    
    ;; Receive TokenTransfer message
    if (op == 0xf8a7ea5) {
        var $msg'queryId = in_msg~load_uint(64);
        var $msg'amount = in_msg~load_varuint16();
        var $msg'destination = in_msg~load_msg_addr();
        var $msg'responseDestination = in_msg~load_msg_addr();
        var $msg'customPayload = in_msg~load_maybe_ref();
        var $msg'forwardTonAmount = in_msg~load_varuint16();
        var $msg'forwardPayload = in_msg;
        throw_unless(17062, ($msg'amount > 0));
        throw_unless(14534, ( equal_slices_bits(__tact_context_get_sender(), $self'owner) ));
