;; QUASAR Jetton Minter Contract
;; The brightest token in the TON universe

#include "imports/stdlib.fc";

const int op::mint = 0x1674b0a0;
const int op::internal_transfer = 0x178d4519;
const int op::burn = 0x595f07bc;
const int op::burn_notification = 0x7bdd97de;

(int, slice, slice, cell) load_data() inline {
    var ds = get_data().begin_parse();
    return (
        ds~load_coins(),           ;; total_supply
        ds~load_msg_addr(),        ;; admin_address
        ds~load_msg_addr(),        ;; jetton_wallet_code
        ds~load_ref()              ;; jetton_content
    );
}

() save_data(int total_supply, slice admin_address, slice jetton_wallet_code, cell jetton_content) impure inline {
    set_data(begin_cell()
        .store_coins(total_supply)
        .store_slice(admin_address)
        .store_slice(jetton_wallet_code)
        .store_ref(jetton_content)
        .end_cell());
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) { return (); }
    
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) { return (); }
    
    slice sender_address = cs~load_msg_addr();
    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);
    
    var (total_supply, admin_address, jetton_wallet_code, jetton_content) = load_data();
    
    if (op == op::mint) {
        throw_unless(73, equal_slices(sender_address, admin_address));
        int amount = in_msg_body~load_coins();
        slice to_address = in_msg_body~load_msg_addr();
        
        total_supply += amount;
        save_data(total_supply, admin_address, jetton_wallet_code, jetton_content);
        
        ;; Deploy wallet and send tokens
        cell state_init = calculate_jetton_wallet_state_init(to_address, my_address(), jetton_wallet_code);
        slice wallet_address = calculate_address(state_init);
        
        var msg = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(wallet_address)
            .store_coins(0)
            .store_uint(4 + 2 + 1, 1 + 4 + 4 + 64 + 32 + 1 + 1 + 1)
            .store_ref(state_init)
            .store_ref(begin_cell()
                .store_uint(op::internal_transfer, 32)
                .store_uint(query_id, 64)
                .store_coins(amount)
                .store_slice(sender_address)
                .store_slice(sender_address)
                .store_coins(0)
                .store_slice(empty_slice())
                .end_cell());
        
        send_raw_message(msg.end_cell(), 1);
        return ();
    }
    
    if (op == op::burn_notification) {
        int amount = in_msg_body~load_coins();
        slice owner_address = in_msg_body~load_msg_addr();
        
        total_supply -= amount;
        save_data(total_supply, admin_address, jetton_wallet_code, jetton_content);
        return ();
    }
}

(int, int, slice, cell, cell) get_jetton_data() method_id {
    var (total_supply, admin_address, jetton_wallet_code, jetton_content) = load_data();
    return (total_supply, -1, admin_address, jetton_content, begin_cell().store_slice(jetton_wallet_code).end_cell());
}

slice get_wallet_address(slice owner_address) method_id {
    var (_, _, _, jetton_wallet_code, _) = load_data();
    cell state_init = calculate_jetton_wallet_state_init(owner_address, my_address(), jetton_wallet_code);
    return calculate_address(state_init);
}
