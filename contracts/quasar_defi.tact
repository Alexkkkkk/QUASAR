import '@stdlib/deploy' ; import '@stdlib/content' ; // ═══════════════════════════════════════════════════════════════ // QUASAR DeFi Module — DEX | Liquidity | Yield Farming // ═══════════════════════════════════════════════════════════════ message AddLiquidity { tonAmount: Int as coins ; qsrAmount: Int as coins ; } message RemoveLiquidity { lpAmount: Int as coins ; } message SwapToTON { qsrAmount: Int as coins ; minTonOut: Int as coins ; } message SwapToQSR { tonAmount: Int as coins ; minQsrOut: Int as coins ; } message ClaimFarmRewards { } message StakeLP { amount: Int as coins ; } message UnstakeLP { amount: Int as coins ; } message SetFarmConfig { rewardPerSecond: Int as coins ; startTime: Int as uint32 ; endTime: Int as uint32 ; } struct LPInfo { totalSupply: Int ; tonReserve: Int ; qsrReserve: Int ; } struct FarmInfo { staked: Int ; rewardPerSecond: Int ; lastUpdate: Int ; accRewardPerShare: Int ; startTime: Int ; endTime: Int ; } struct UserFarmInfo { staked: Int ; debt: Int ; pending: Int ; } contract QuasarDeFi with Deployable { owner: Address ; qsrMaster: Address ; // LP Pool lpTotalSupply: Int as coins ; tonReserve: Int as coins ; qsrReserve: Int as coins ; lpBalances: map<Address, Int> ; // Farm farmEnabled: Bool ; farmRewardPerSecond: Int as coins ; farmStartTime: Int as uint32 ; farmEndTime: Int as uint32 ; farmLastUpdate: Int ; farmAccRewardPerShare: Int ; farmTotalStaked: Int as coins ; farmStakes: map<Address, UserFarmInfo> ; init(owner: Address, qsrMaster: Address) { self.owner = owner ; self.qsrMaster = qsrMaster ; self.lpTotalSupply = 0 ; self.tonReserve = 0 ; self.qsrReserve = 0 ; self.farmEnabled = true ; self.farmRewardPerSecond = 100000000 ; self.farmStartTime = now() ; self.farmEndTime = now() + 31536000 ; self.farmLastUpdate = now() ; self.farmAccRewardPerShare = 0 ; self.farmTotalStaked = 0 ; } receive() { } receive(msg: AddLiquidity) { require(msg.tonAmount > 0 && msg.qsrAmount > 0, 'Invalid amounts') ; let lpToMint: Int = 0 ; if (self.lpTotalSupply == 0) { lpToMint = sqrt(msg.tonAmount * msg.qsrAmount) ; } else { let lpByTon: Int = (msg.tonAmount * self.lpTotalSupply) / self.tonReserve ; let lpByQsr: Int = (msg.qsrAmount * self.lpTotalSupply) / self.qsrReserve ; lpToMint = min(lpByTon, lpByQsr) ; } require(lpToMint > 0, 'Zero LP') ; self.tonReserve += msg.tonAmount ; self.qsrReserve += msg.qsrAmount ; self.lpTotalSupply += lpToMint ; let current: Int? = self.lpBalances.get(sender()) ; if (current == null) { self.lpBalances.set(sender(), lpToMint) ; } else { self.lpBalances.set(sender(), current!! + lpToMint) ; } self._updateFarm() ; let stake: UserFarmInfo? = self.farmStakes.get(sender()) ; if (stake == null) { self.farmStakes.set(sender(), UserFarmInfo{staked: lpToMint, debt: self.farmAccRewardPerShare, pending: 0}) ; } else { let s: UserFarmInfo = stake!! ; let pending: Int = (s.staked * (self.farmAccRewardPerShare - s.debt)) / 1000000000 ; self.farmStakes.set(sender(), UserFarmInfo{staked: s.staked + lpToMint, debt: self.farmAccRewardPerShare, pending: s.pending + pending}) ; } self.farmTotalStaked += lpToMint ; } receive(msg: RemoveLiquidity) { let current: Int? = self.lpBalances.get(sender()) ; require(current != null && current!! >= msg.lpAmount, 'Insufficient LP') ; let tonOut: Int = (msg.lpAmount * self.tonReserve) / self.lpTotalSupply ; let qsrOut: Int = (msg.lpAmount * self.qsrReserve) / self.lpTotalSupply ; self._updateFarm() ; let stake: UserFarmInfo? = self.farmStakes.get(sender()) ; require(stake != null && stake!!.staked >= msg.lpAmount, 'Farm stake insufficient') ; let s: UserFarmInfo = stake!! ; let pending: Int = (s.staked * (self.farmAccRewardPerShare - s.debt)) / 1000000000 ; self.farmStakes.set(sender(), UserFarmInfo{staked: s.staked - msg.lpAmount, debt: self.farmAccRewardPerShare, pending: s.pending + pending}) ; self.farmTotalStaked -= msg.lpAmount ; self.lpBalances.set(sender(), current!! - msg.lpAmount) ; self.lpTotalSupply -= msg.lpAmount ; self.tonReserve -= tonOut ; self.qsrReserve -= qsrOut ; send(SendParameters{to: sender(), value: tonOut, mode: SendIgnoreErrors, body: emptyCell()}) ; } receive(msg: SwapToTON) { require(msg.qsrAmount > 0 && self.qsrReserve > 0, 'Invalid swap') ; let tonOut: Int = (msg.qsrAmount * self.tonReserve) / (self.qsrReserve + msg.qsrAmount) ; require(tonOut >= msg.minTonOut, 'Slippage exceeded') ; self.qsrReserve += msg.qsrAmount ; self.tonReserve -= tonOut ; send(SendParameters{to: sender(), value: tonOut, mode: SendIgnoreErrors, body: emptyCell()}) ; } receive(msg: SwapToQSR) { require(msg.tonAmount > 0 && self.tonReserve > 0, 'Invalid swap') ; let qsrOut: Int = (msg.tonAmount * self.qsrReserve) / (self.tonReserve + msg.tonAmount) ; require(qsrOut >= msg.minQsrOut, 'Slippage exceeded') ; self.tonReserve += msg.tonAmount ; self.qsrReserve -= qsrOut ; } receive(msg: ClaimFarmRewards) { self._updateFarm() ; let stake: UserFarmInfo? = self.farmStakes.get(sender()) ; require(stake != null && stake!!.staked > 0, 'No stake') ; let s: UserFarmInfo = stake!! ; let pending: Int = (s.staked * (self.farmAccRewardPerShare - s.debt)) / 1000000000 ; let totalReward: Int = s.pending + pending ; require(totalReward > 0, 'No rewards') ; self.farmStakes.set(sender(), UserFarmInfo{staked: s.staked, debt: self.farmAccRewardPerShare, pending: 0}) ; send(SendParameters{to: sender(), value: totalReward, mode: SendIgnoreErrors, body: emptyCell()}) ; } receive(msg: SetFarmConfig) { require(sender() == self.owner, 'Only owner') ; self.farmRewardPerSecond = msg.rewardPerSecond ; self.farmStartTime = msg.startTime ; self.farmEndTime = msg.endTime ; } fun _updateFarm() { if (now() <= self.farmLastUpdate || self.farmTotalStaked == 0) { return } let end: Int = min(now(), self.farmEndTime) ; let multiplier: Int = end - self.farmLastUpdate ; let reward: Int = multiplier * self.farmRewardPerSecond ; self.farmAccRewardPerShare += (reward * 1000000000) / self.farmTotalStaked ; self.farmLastUpdate = now() ; } get fun lpBalance(user: Address): Int { let b: Int? = self.lpBalances.get(user) ; return b == null ? 0 : b!! } get fun poolInfo(): LPInfo { return LPInfo{totalSupply: self.lpTotalSupply, tonReserve: self.tonReserve, qsrReserve: self.qsrReserve} } get fun farmInfo(): FarmInfo { return FarmInfo{staked: self.farmTotalStaked, rewardPerSecond: self.farmRewardPerSecond, lastUpdate: self.farmLastUpdate, accRewardPerShare: self.farmAccRewardPerShare, startTime: self.farmStartTime, endTime: self.farmEndTime} } get fun userFarm(user: Address): UserFarmInfo { let s: UserFarmInfo? = self.farmStakes.get(user) ; return s == null ? UserFarmInfo{staked: 0, debt: 0, pending: 0} : s!! } }