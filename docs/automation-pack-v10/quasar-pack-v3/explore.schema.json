{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "kind", "severity", "why"],
        "properties": {
          "file": { "type": "string", "maxLength": 200 },
          "kind": { "enum": ["bug", "dead", "test", "doc", "sec"] },
          "severity": { "type": "integer", "minimum": 1, "maximum": 3 },
          "line": { "type": "integer", "minimum": 0 },
          "why": { "type": "string", "maxLength": 500 },
          "fix_hint": { "type": "string", "maxLength": 500 }
        }
      }
    }
  }
}
