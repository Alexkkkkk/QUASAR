{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["solutions"],
  "properties": {
    "solutions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["problem_id", "root_cause", "fix_plan", "auto_fixable", "confidence"],
        "properties": {
          "problem_id": { "type": "integer", "minimum": 0 },
          "root_cause": { "type": "string", "maxLength": 400 },
          "fix_plan": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 5 },
          "auto_fixable": { "type": "boolean" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "target_issue": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
