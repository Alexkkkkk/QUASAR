{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "paths": {
      "App": ["./src/App"],
      "assets": ["./src/assets"], "assets/*": ["./src/assets/*"],
      "components": ["./src/components"], "components/*": ["./src/components/*"],
      "consts": ["./src/consts"], "consts/*": ["./src/consts/*"],
      "helpers": ["./src/helpers"], "helpers/*": ["./src/helpers/*"],
      "hooks": ["./src/hooks"], "hooks/*": ["./src/hooks/*"],
      "lib": ["./src/lib"], "lib/*": ["./src/lib/*"],
      "pages": ["./src/pages"], "pages/*": ["./src/pages/*"],
      "services": ["./src/services"], "services/*": ["./src/services/*"],
      "store": ["./src/store"], "store/*": ["./src/store/*"],
      "theme": ["./src/theme"], "theme/*": ["./src/theme/*"],
      "utils": ["./src/utils"], "utils/*": ["./src/utils/*"]
    },
    "rootDir": "./src",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src"]
}
