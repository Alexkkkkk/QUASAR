  "dependencies": {
    "@tact-lang/compiler": "^1.6.13",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@ton/sandbox": "^0.44.0",
    "@types/node": "^26.5.1",
    "husky": "^9.1.7",
