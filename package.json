{
  "name": "quasar-jetton",
  "version": "3.0.0",
  "description": "QUASAR — The brightest Jetton in the TON universe. AI Sovereignty | DeFi DEX | Yield Farming | Web3",
  "main": "index.js",
  "homepage": "https://alexkkkkk.github.io/QUASAR",
  "type": "module",
  "scripts": {
    "build": "tact --config tact.config.json",
    "deploy": "tsx scripts/deploy_all.ts",
    "deploy:defi": "tsx scripts/deploy_defi.ts",
    "test": "npm run build && npm run security:check && node --import tsx --test tests/*.test.ts",
    "lint": "tact --config tact.config.json --check",
    "abi:check": "npm run build && npm run abi:verify",
    "abi:verify": "tsx scripts/check_abi.ts",
    "abi:dapp": "tsx scripts/check_dapp_abi.ts",
    "abi:update": "npm run build && tsx scripts/check_abi.ts --update",
    "website": "npx serve website",
    "security:check": "tsx scripts/security_check.ts",
    "deployment:check": "tsx scripts/check_deployment.ts",
    "tonconnect:smoke": "tsx scripts/check_tonconnect.ts",
    "testnet:smoke": "tsx scripts/testnet_smoke.ts",
    "hashes:build": "npm run build && tsx scripts/build_hashes.ts --write",
    "oracle:smoke": "tsx scripts/ai_oracle.ts",
    "oracle:test": "node --import tsx --test tests/ai_oracle.test.ts",
    "oracle:sign": "tsx scripts/ai_oracle.ts sign",
    "oracle:signed:test": "node --import tsx --test tests/ai_oracle_signed.test.ts"
  },
  "keywords": [
    "ton",
    "jetton",
    "quasar",
    "tact",
    "blockchain",
    "defi",
    "dex",
    "yield-farming",
    "amm",
    "web3",
    "ai-oracle"
  ],
  "author": "QUASAR Team",
  "license": "MIT",
  "engines": {
    "node": "^22 || ^24"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@tact-lang/compiler": "^1.6.13",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0"
  },
  "devDependencies": {
    "@ton/sandbox": "^0.45.0",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.4",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@ton/sandbox": "$@ton/sandbox",
    "protobufjs": "^8.8.0"
  }
}
