{
  "name": "quasar-jetton",
  "version": "3.0.0",
  "description": "QUASAR — TON Jetton and DeFi prototype implemented in Tolk",
  "main": "index.js",
  "homepage": "https://alexkkkkk.github.io/QUASAR",
  "type": "module",
  "scripts": {
    "acton:init": "cd tolk && acton init --stdlib-only",
    "build": "python3 scripts/sync_acton.py",
    "test": "npm run build && npm run security:check && node --import tsx --test tests/*.test.ts tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:tolk": "cd tolk && acton test",
    "lint": "cd tolk && acton fmt --check && acton build && acton wrapper --all --output-dir build/synchronized/wrappers && acton check",
    "abi:check": "npm run build && npm run abi:verify",
    "abi:verify": "python3 scripts/acton_abi.py",
    "abi:migration:check": "python3 scripts/check_migration_parity.py",
    "abi:dapp": "tsx scripts/check_dapp_abi.ts",
    "abi:update": "cd tolk && acton build && cd .. && python3 scripts/acton_abi.py --update",
    "website": "npx serve website",
    "security:check": "tsx scripts/security_check.ts",
    "deployment:check": "tsx scripts/check_deployment.ts",
    "tonconnect:smoke": "tsx scripts/check_tonconnect.ts",
    "hashes:build": "npm run build && tsx scripts/build_hashes.ts --write",
    "oracle:smoke": "tsx scripts/ai_oracle.ts",
    "oracle:test": "node --import tsx --test tests/ai_oracle.test.ts",
    "oracle:signals:test": "node --import tsx --test tests/oracle_signals.test.ts tests/ai_oracle_signals.test.ts",
    "oracle:keygen": "tsx scripts/ai_oracle.ts keygen",
    "oracle:sign": "tsx scripts/ai_oracle.ts sign",
    "ton:docs:sync": "python3 scripts/sync_ton_docs.py",
    "ton:docs:check": "python3 scripts/sync_ton_docs.py --check",
    "ai:agent:test": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "hub:audit": "tsx scripts/hub_audit.ts",
    "hub:test": "node --import tsx --test tests/automation_hub.test.ts && node --test tests/router.test.mjs",
    "pins:sync": "tsx scripts/sync_action_pins.ts",
    "pins:check": "tsx scripts/sync_action_pins.ts --check"
  },
  "keywords": [
    "ton",
    "jetton",
    "quasar",
    "tolk",
    "acton",
    "blockchain",
    "defi",
    "dex",
    "yield-farming",
    "amm",
    "web3",
    "ai-oracle"
  ],
  "author": "QUASAR Team",
  "license": "MIT",
  "engines": {
    "node": "^22 || ^24"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0"
  },
  "devDependencies": {
    "@ton/sandbox": "^0.45.0",
    "@ton/tolk-abi-to-typescript": "0.5.0",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@ton/sandbox": "$@ton/sandbox",
    "protobufjs": "^8.8.0",
    "zod": "4.6.7",
    "fast-uri": "^3.1.9"
  }
}
